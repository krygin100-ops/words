<g fill="{L}"><circle cx="70" cy="120" r="30"/><circle cx="130" cy="100" r="30"/></g>
<text x="70" y="130" font-size="26" text-anchor="middle" fill="#000" stroke="none" font-family="sans-serif">$</text>
<text x="130" y="110" font-size="26" text-anchor="middle" fill="#000" stroke="none" font-family="sans-serif">€</text>
<rect x="50" y="30" width="100" height="35" rx="4" fill="{F}"/>
