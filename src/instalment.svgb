<rect x="20" y="70" width="40" height="70" fill="{F}"/>
<rect x="80" y="70" width="40" height="70" fill="{F}"/>
<rect x="140" y="70" width="40" height="70" stroke-dasharray="6 5"/>
<text x="40" y="112" font-size="20" text-anchor="middle" fill="{L}" stroke="none" font-family="sans-serif">1</text>
<text x="100" y="112" font-size="20" text-anchor="middle" fill="{L}" stroke="none" font-family="sans-serif">2</text>
<text x="160" y="112" font-size="20" text-anchor="middle" fill="{L}" stroke="none" font-family="sans-serif">3</text>
<text x="100" y="45" font-size="22" text-anchor="middle" fill="{L}" stroke="none" font-family="sans-serif">$ / month</text>
